# Runtime state — generated by the app on first run, never shipped
data/config.json
data/projects.json
data/logs/*.log
data/home/*
data/composer-home/*
data/*.phar
data/composer-lib
!data/logs/.gitkeep
!data/home/.gitkeep
!data/composer-home/.gitkeep

# Personal / assistant-session context — not part of the project
CLAUDE.md

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp

# Local scratch scripts (prefix convention: throwaway, never committed)
/_*.php
